  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "github:lumine-code/sofistik-reader#f7e0fe9488891c6ec87e532ffdf8fce4d1120cf0": true
  }
}
