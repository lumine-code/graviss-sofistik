      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/sofistik-env": "github:lumine-code/sofistik-env#63a6dab325fd658e50b232c977ad917a4adb15dc",
