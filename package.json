{
  "name": "graviss-sofistik",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Read finite element models from SOFiSTiK CDB databases.",
  "keywords": [
    "cdb",
    "structural-analysis",
    "finite-element",
    "fem",
    "engineering"
  ],
  "repository": "https://github.com/lumine-code/graviss-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/graviss-sofistik/issues"
  },
  "homepage": "https://github.com/lumine-code/graviss-sofistik#readme",
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:node": "jasmine --config=spec/support/jasmine.node.json"
  },
  "providedServices": {
    "graviss.source": {
      "description": "Reads SOFiSTiK CDB databases into Graviss model sessions.",
      "versions": {
        "1.0.0": "provideGravissSource"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/sofistik-context": "github:lumine-code/sofistik-context#1a23b04a747e4902e0934d4c60500987a50d514a",
    "@lumine-code/sofistik-reader": "github:lumine-code/sofistik-reader#baeac9c4bf27475509244b251df8ab579aa324ef"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "jasmine": "^7.0.0",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "github:lumine-code/sofistik-reader#baeac9c4bf27475509244b251df8ab579aa324ef": true
  },
  "specPackages": [
    "graviss"
  ]
}
