{
  "name": "graviss-sofistik",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Read finite element models from SOFiSTiK CDB databases.",
  "keywords": [
    "cdb",
    "structural-analysis",
    "finite-element",
    "fem",
    "engineering"
  ],
  "repository": "https://github.com/lumine-code/graviss-sofistik",
  "bugs": {
    "url": "https://github.com/lumine-code/graviss-sofistik/issues"
  },
  "homepage": "https://github.com/lumine-code/graviss-sofistik#readme",
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "docs",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:node": "jasmine --config=spec/support/jasmine.node.json"
  },
  "providedServices": {
    "graviss.source": {
      "description": "Reads SOFiSTiK CDB databases into Graviss model sessions.",
      "versions": {
        "1.0.0": "provideGravissSource"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/sofistik-context": "github:lumine-code/sofistik-context#b8c849aec69ec146342ebe5bbf5e023bbafe2b1c",
    "@lumine-code/sofistik-reader": "github:lumine-code/sofistik-reader#1e9529d9e392c4682c9f1510739ce55cf43abe05"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jasmine": "^7.0.0",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "github:lumine-code/sofistik-reader#1e9529d9e392c4682c9f1510739ce55cf43abe05": true
  },
  "specPackages": [
    "graviss"
  ],
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    },
    "jasmine@^7.0.0": {
      "glob": "14.0.4"
    }
  }
}
